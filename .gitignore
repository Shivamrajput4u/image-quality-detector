# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Node
node_modules/
dist/
.vite/

# Env files
.env
.env.local

# Database
*.db
*.sqlite3

# Model artifacts (large binaries — track separately if needed)
*.pt
*.pth
# ...except the actual shipped model — small (~4MB) and required for the
# app to run out of the box without retraining.
!backend/ml/artifacts/autoencoder.pth

# Raw training dataset (regenerate via ml/download_dataset.py, ~5GB — not shipped)
backend/data/mvtec/
backend/ml/_mvtec_raw/

# Runtime uploads — real user photos, never committed (data/samples/ IS committed — curated demo images)
backend/data/uploads/*
!backend/data/uploads/.gitkeep
backend/data/app.db

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Local port-conflict overrides — machine-specific, not part of the shipped config
docker-compose.override.yml
